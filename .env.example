OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Qdrant vector store
QDRANT_URL=http://localhost:6333
# Embedding dimension — must match your Ollama model (llama3.2 = 3072)
EMBED_DIM=3072

SQLITE_DB_PATH=./sites.db

# Generate a strong secret: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=change-me-in-production

# Fernet key for encrypting business plan API keys at rest.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, API keys are stored in plaintext (not recommended for production).
FERNET_KEY=

# Maximum file upload size in bytes (default: 10 MB)
MAX_UPLOAD_BYTES=10485760

# Comma-separated list of allowed CORS origins (leave empty to disallow all cross-origin requests)
ALLOWED_ORIGINS=https://yourdomain.com

# Chat response cache
CHAT_CACHE_TTL=300
CHAT_CACHE_MAX=500